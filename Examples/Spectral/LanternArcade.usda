#usda 1.0
(
    doc = """Lantern arcade: an 80 m colonnade at night under two strings of warm lanterns, with side halls of lamps hung at varied heights, over polished stone that mirrors them: 416 lamps from 2000 K to 6500 K. Each point is lit by its few nearest lamps; the light tree (Render > Light sampling) finds them, while power sampling spreads its samples over all of them. Colour temperatures render as blackbody spectra in spectral transport and as their colour in RGB."""
    defaultPrim = "Scene"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Scene"
{
    def Scope "Looks"
    {
        # Polished dark stone: the lamps reflect in it.
        def Material "Stone"
        {
            token outputs:mtlx:surface.connect = </Scene/Looks/Stone/Surface.outputs:out>
            def Shader "Surface"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                color3f inputs:base_color = (0.06, 0.06, 0.065)
                float inputs:specular_roughness = 0.12
                token outputs:out
            }
        }

        def Material "Pillar"
        {
            token outputs:mtlx:surface.connect = </Scene/Looks/Pillar/Surface.outputs:out>
            def Shader "Surface"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                color3f inputs:base_color = (0.62, 0.56, 0.48)
                float inputs:specular_roughness = 0.55
                token outputs:out
            }
        }

        def Material "Red"
        {
            token outputs:mtlx:surface.connect = </Scene/Looks/Red/Surface.outputs:out>
            def Shader "Surface"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                color3f inputs:base_color = (0.7, 0.08, 0.06)
                float inputs:specular_roughness = 0.3
                token outputs:out
            }
        }

        def Material "Teal"
        {
            token outputs:mtlx:surface.connect = </Scene/Looks/Teal/Surface.outputs:out>
            def Shader "Surface"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                color3f inputs:base_color = (0.05, 0.45, 0.45)
                float inputs:specular_roughness = 0.3
                token outputs:out
            }
        }

        def Material "Chrome"
        {
            token outputs:mtlx:surface.connect = </Scene/Looks/Chrome/Surface.outputs:out>
            def Shader "Surface"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                float inputs:base_metalness = 1
                color3f inputs:base_color = (0.92, 0.92, 0.92)
                float inputs:specular_roughness = 0.04
                token outputs:out
            }
        }
    }

    def Camera "Camera"
    {
        double3 xformOp:translate = (0.4, 1.1, 12.5)
        float3 xformOp:rotateXYZ = (1.40983, 1.05765, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        float focalLength = 22
        float horizontalAperture = 36
        float verticalAperture = 20.25
        float2 clippingRange = (0.01, 100)
    }

    class RectLight "_Lantern"
    {
        float3 xformOp:rotateXYZ = (-90, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        float inputs:width = 0.12
        float inputs:height = 0.12
        float inputs:intensity = 1400
        bool inputs:enableColorTemperature = true
    }

    class RectLight "_HallLamp"
    {
        float3 xformOp:rotateXYZ = (-90, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        float inputs:width = 0.2
        float inputs:height = 0.2
        float inputs:intensity = 700
        bool inputs:enableColorTemperature = true
    }

    class Cylinder "_Pillar" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Y"
        double radius = 0.28
        double height = 4.2
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </Scene/Looks/Pillar>
    }

    class Cylinder "_Column" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Y"
        double radius = 0.16
        double height = 4.6
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </Scene/Looks/Pillar>
    }

    class Cube "_Lintel" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        float3 xformOp:scale = (6.8, 0.3, 0.45)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </Scene/Looks/Pillar>
    }

    def Cube "Floor" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (0, -0.05, -30)
        float3 xformOp:scale = (70, 0.1, 90)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </Scene/Looks/Stone>
    }

