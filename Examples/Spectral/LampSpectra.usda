            }
        }

        def Material "Blue"
        {
            token outputs:mtlx:surface.connect = </Scene/Looks/Blue/Surface.outputs:out>
            def Shader "Surface"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                color3f inputs:base_color = (0.08, 0.15, 0.65)
                float inputs:specular_roughness = 0.3
                token outputs:out
            }
        }
    }

    def Camera "Camera"
    {
        double3 xformOp:translate = (0, 1.6, 5.2)
        float3 xformOp:rotateXYZ = (-10.8855, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        float focalLength = 30
        float horizontalAperture = 36
        float verticalAperture = 20.25
        float2 clippingRange = (0.01, 100)
    }

