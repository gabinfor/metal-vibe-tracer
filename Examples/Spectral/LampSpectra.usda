#usda 1.0
(
    doc = """Lamp spectra: the same red, green and blue spheres under five spot lamps of equal luminance in light haze: a 2700 K blackbody, CIE D65, FL11 (fluorescent), HP1 (sodium) and LED-B3. Under sodium light the colours collapse to orange and black. The lamps' spectra render in spectral transport; RGB uses the blackbody's colour and keeps presets white."""
    defaultPrim = "Scene"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Scene"
{
    float vibe:medium:density = 0.06
    color3f vibe:medium:albedo = (0.95, 0.95, 0.95)
    float vibe:medium:anisotropy = 0.5

    def Scope "Looks"
    {
        def Material "Floor"
        {
            token outputs:mtlx:surface.connect = </Scene/Looks/Floor/Surface.outputs:out>
            def Shader "Surface"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                color3f inputs:base_color = (0.18, 0.18, 0.18)
                float inputs:specular_roughness = 0.5
                token outputs:out
            }
        }

        def Material "Plinth"
        {
            token outputs:mtlx:surface.connect = </Scene/Looks/Plinth/Surface.outputs:out>
            def Shader "Surface"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                color3f inputs:base_color = (0.8, 0.8, 0.8)
                float inputs:specular_roughness = 0.5
                token outputs:out
            }
        }

        def Material "Red"
        {
            token outputs:mtlx:surface.connect = </Scene/Looks/Red/Surface.outputs:out>
