        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </Scene/Looks/N_FK51A>
    }

    def Cylinder "Slit_N_SF11" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        # Where the d-line ray leaving N-SF11 meets a slit 2 m away.
        uniform token axis = "Y"
        double radius = 0.004
        double height = 1.2
        double3 xformOp:translate = (-3.2536, 0.6, -0.0917)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </Scene/Looks/LightBar>
    }

    def Cylinder "Slit_F2" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        # Where the d-line ray leaving F2 meets a slit 2 m away.
        uniform token axis = "Y"
        double radius = 0.004
        double height = 1.2
        double3 xformOp:translate = (-2.1461, 0.6, -1.2306)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </Scene/Looks/LightBar>
    }

    def Cylinder "Slit_N_BK7" (
