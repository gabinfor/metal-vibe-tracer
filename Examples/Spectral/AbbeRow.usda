    )
    {
        # Rotated to minimum deviation (36.0 degrees at the d line) for the camera ray through its centre.
        int[] faceVertexCounts = [3, 3, 4, 4, 4]
        int[] faceVertexIndices = [0, 2, 1, 3, 4, 5, 0, 1, 4, 3, 1, 2, 5, 4, 2, 0, 3, 5]
        point3f[] points = [(0.20752, 0, 0.01160), (-0.09371, 0, -0.18552), (-0.11381, 0, 0.17392), (0.20752, 0.55, 0.01160), (-0.09371, 0.55, -0.18552), (-0.11381, 0.55, 0.17392)]
