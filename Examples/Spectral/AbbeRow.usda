#usda 1.0
(
    doc = """Abbe row: 60-degree prisms of SCHOTT N-SF11, F2, N-BK7 and N-FK51A (Abbe numbers 25.7 to 84.5) each turned to minimum deviation towards a thin white slit, as in a spectroscope. Through each prism its slit spreads into a spectrum, wider as the Abbe number falls. Dispersion renders in spectral light transport only."""
    defaultPrim = "Scene"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Scene"
{
    def Scope "Looks"
    {
        def Material "Floor"
        {
            token outputs:mtlx:surface.connect = </Scene/Looks/Floor/Surface.outputs:out>
            def Shader "Surface"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                color3f inputs:base_color = (0.2, 0.2, 0.2)
                float inputs:specular_roughness = 0.3
                token outputs:out
            }
        }

        def Material "LightBar"
        {
            token outputs:mtlx:surface.connect = </Scene/Looks/LightBar/Surface.outputs:out>
            def Shader "Surface"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                color3f inputs:base_color = (0, 0, 0)
                color3f inputs:emission_color = (1, 1, 1)
                float inputs:emission_luminance = 60
                token outputs:out
            }
        }

        # SCHOTT N-SF11: n_d = 1.78472, V_d = 25.68 (REFERENCES.md SCHOTTGLASS).
        def Material "N_SF11"
        {
            token outputs:mtlx:surface.connect = </Scene/Looks/N_SF11/Surface.outputs:out>
            def Shader "Surface"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                color3f inputs:base_color = (1, 1, 1)
                float inputs:specular_ior = 1.78472
                float inputs:specular_roughness = 0
                float inputs:transmission_weight = 1
                float inputs:transmission_dispersion_scale = 1
                float inputs:transmission_dispersion_abbe_number = 25.68
                token outputs:out
            }
        }

        # SCHOTT F2: n_d = 1.62004, V_d = 36.37 (REFERENCES.md SCHOTTGLASS).
        def Material "F2"
        {
            token outputs:mtlx:surface.connect = </Scene/Looks/F2/Surface.outputs:out>
            def Shader "Surface"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                color3f inputs:base_color = (1, 1, 1)
                float inputs:specular_ior = 1.62004
                float inputs:specular_roughness = 0
                float inputs:transmission_weight = 1
                float inputs:transmission_dispersion_scale = 1
                float inputs:transmission_dispersion_abbe_number = 36.37
                token outputs:out
            }
        }

        # SCHOTT N-BK7: n_d = 1.5168, V_d = 64.17 (REFERENCES.md SCHOTTGLASS).
        def Material "N_BK7"
        {
            token outputs:mtlx:surface.connect = </Scene/Looks/N_BK7/Surface.outputs:out>
            def Shader "Surface"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                color3f inputs:base_color = (1, 1, 1)
                float inputs:specular_ior = 1.5168
                float inputs:specular_roughness = 0
                float inputs:transmission_weight = 1
                float inputs:transmission_dispersion_scale = 1
                float inputs:transmission_dispersion_abbe_number = 64.17
                token outputs:out
            }
        }

        # SCHOTT N-FK51A: n_d = 1.48656, V_d = 84.47 (REFERENCES.md SCHOTTGLASS).
        def Material "N_FK51A"
        {
            token outputs:mtlx:surface.connect = </Scene/Looks/N_FK51A/Surface.outputs:out>
            def Shader "Surface"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                color3f inputs:base_color = (1, 1, 1)
                float inputs:specular_ior = 1.48656
                float inputs:specular_roughness = 0
                float inputs:transmission_weight = 1
                float inputs:transmission_dispersion_scale = 1
                float inputs:transmission_dispersion_abbe_number = 84.47
                token outputs:out
            }
        }
    }

    def Camera "Camera"
    {
        double3 xformOp:translate = (0, 0.42, 2.7)
        float3 xformOp:rotateXYZ = (-2.5448, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        float focalLength = 30
        float horizontalAperture = 36
        float verticalAperture = 20.25
        float2 clippingRange = (0.01, 100)
    }

    def Camera "Overview"
    {
        double3 xformOp:translate = (1.2, 4, 3.2)
        float3 xformOp:rotateXYZ = (-42.0835, 28.3008, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        float focalLength = 24
        float horizontalAperture = 36
        float verticalAperture = 20.25
        float2 clippingRange = (0.01, 100)
    }

    def Mesh "Cyclorama" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
