#usda 1.0
(
    doc = """Newton's colour series. Back row: soap films (n 1.33) 100-800 nm thick, first- to fourth-order interference colours. Front row: anodized titanium, oxide films (n 2.4) 30-150 nm. Thin film renders in spectral light transport only."""
    defaultPrim = "Scene"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Scene"
{
    def Scope "Looks"
    {
        def Material "Floor"
        {
            token outputs:mtlx:surface.connect = </Scene/Looks/Floor/Surface.outputs:out>
            def Shader "Surface"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                color3f inputs:base_color = (0.15, 0.15, 0.16)
                float inputs:specular_roughness = 0.35
                token outputs:out
            }
        }

        # Soap film (n = 1.33) 100 nm thick over an index-matched black base: the film alone reflects.
        def Material "Soap_100nm"
        {
            token outputs:mtlx:surface.connect = </Scene/Looks/Soap_100nm/Surface.outputs:out>
            def Shader "Surface"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                color3f inputs:base_color = (0, 0, 0)
                float inputs:specular_ior = 1
                float inputs:specular_roughness = 0.03
                float inputs:thin_film_weight = 1
                float inputs:thin_film_thickness = 0.1
                float inputs:thin_film_ior = 1.33
                token outputs:out
            }
        }

